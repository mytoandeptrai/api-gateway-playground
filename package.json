{
  "name": "turbo-app-template",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "dev:services": "turbo run dev --concurrency=15 --filter=api-gateway --filter=auth-service --filter=order-service --filter=inventory-service --filter=orchestrator-service --filter=payment-service --filter=refund-service --filter=shipping-service --filter=notification-service --filter=product-service",
    "only-infra": "cd docker && docker compose up -d"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.5.8",
    "typescript": "5.8.3"
  },
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=18"
  }
}