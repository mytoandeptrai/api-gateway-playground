NODE_ENV=development
PORT=3006
API_PREFIX=api/v1

# CORS
CORS_ENABLED=true
CORS_ORIGINS=http://localhost:3000

# Database
DB_HOST=localhost
DB_PORT=1111
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=api-gateway-db
DB_SCHEMA=orders
DB_SYNC=true
DB_LOGGING=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=1112
REDIS_PASSWORD=
REDIS_DB=0

# Swagger
SWAGGER_ENABLED=true
SWAGGER_TITLE=API Gateway API
SWAGGER_DESCRIPTION=API documentation for API Gateway
SWAGGER_VERSION=1.0
SWAGGER_PATH=api/docs

# Kafka
KAFKA_BROKERS=localhost:1115
KAFKA_CLIENT_ID=order-service
KAFKA_GROUP_ID=order-group
KAFKA_SESSION_TIMEOUT=30000
KAFKA_HEARTBEAT_INTERVAL=3000

# JWT (same secret as auth-service)
JWT_SECRET=your-jwt-access-secret

# Internal service URLs
PRODUCT_SERVICE_URL=http://localhost:3005

# Payment
PAYMENT_TIMEOUT_MINUTES=15
